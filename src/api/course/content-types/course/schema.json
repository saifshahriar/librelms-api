{
	"kind": "collectionType",
	"collectionName": "courses",
	"info": {
		"singularName": "course",
		"pluralName": "courses",
		"displayName": "Course"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"title": {
			"type": "string",
			"required": true,
			"minLength": 1
		},
		"description": {
			"type": "text"
		},
		"instructors": {
			"type": "relation",
			"relation": "manyToMany",
			"target": "plugin::users-permissions.user"
		},
		"lessons": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "api::lesson.lesson",
			"mappedBy": "course"
		},
		"quizzes": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "api::quiz.quiz",
			"mappedBy": "course"
		},
		"coverImage": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"images"
			]
		}
	}
}