{
	"kind": "collectionType",
	"collectionName": "posts",
	"info": {
		"singularName": "post",
		"pluralName": "posts",
		"displayName": "Post"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {},
	"attributes": {
		"title": {
			"type": "string",
			"required": true,
			"minLength": 1
		},
		"body": {
			"type": "richtext"
		},
		"author": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user"
		},
		"coverImage": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"images"
			]
		}
	}
}